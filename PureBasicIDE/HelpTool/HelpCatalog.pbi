; ----------------------------------------------------------------------------
;---------- Translations data ---------
; ----------------------------------------------------------------------------
; Translations of the help tool, one block per language.
; Included inside Module pbhelp.
;
; Each block has the format of an Editor.catalog section: "[HelpTool]" then "Key = Value" lines.
; When the tool is integrated in the IDE, copy the lines of each block into the Editor.catalog file of the
; same language (new [HelpTool] section) and remove this file: Language("HelpTool", "Key") is the IDE function.
; Italian, Spanish and Russian only have the 16 first keys (they were not used by the old tool).

DataSection

    Catalog_English:
    Data.s "[HelpTool]"
    Data.s "CommandList = Command index"
    Data.s "ReturnValue = Return value"
    Data.s "None = None"
    Data.s "Remarks = Remarks"
    Data.s "Example = Example"
    Data.s "SeeAlso = See also"
    Data.s "SupportedOs = Supported OS"
    Data.s "Syntax = Syntax"
    Data.s "Description = Description"
    Data.s "Overview = General"
    Data.s "Parameters = Parameters"
    Data.s "Deprecated = Deprecated"
    Data.s "DeprecatedNote = This function is deprecated and may be removed in a future version. It should not be used in newly written code."
    Data.s "CommandIndex = Commands Index"
    Data.s "Constants = PureBasic Constants"
    Data.s "OsFunctions = Platform-dependant Functions"
    Data.s "Help = Help"
    Data.s "Contents = Contents"
    Data.s "Search = Search"
    Data.s "All = All"
    Data.s "Reference = Reference"
    Data.s "Home = Home"
    Data.s "Back = Back"
    Data.s "Forward = Forward"
    Data.s "EditSource = Edit help source"
    Data.s "ToggleContents = Show/hide the index"
    Data.s "Test = Test"
    Data.s "Open = Open"
    Data.s "Run = Run"
    Data.s "Copy = Copy"
    Data.s "ToggleFilters = Show/hide the library filters"
    Data.s "HelpNotFound = The help file Help.zip was not found in the subfolder:"
    Data.s "ModeNormal = Normal window"
    Data.s "ModeSticky = Always on top"
    Data.s "ModeTools = In the tools panel"
    Data.s "" ; end of block

